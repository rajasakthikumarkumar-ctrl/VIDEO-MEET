# ==============================================================
# video-meet — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# This file is safe to commit — it contains only placeholders.
# ==============================================================


# --------------------------------------------------------------
# Application
# --------------------------------------------------------------

# Semantic version tag baked into Docker image names.
# Used by docker-compose as: video-meet-server:${APP_VERSION}
# Default: latest
APP_VERSION=latest

# Node environment for the backend container.
# Values: development | production
NODE_ENV=production


# --------------------------------------------------------------
# Backend (Express + Socket.IO)
# --------------------------------------------------------------

# Port the signaling server listens on inside the container.
# Must match the EXPOSE value in server/Dockerfile (5001).
SERVER_PORT=5001

# Allowed CORS origin(s) sent to the browser from the backend.
# In Docker Compose the client container proxies /api and
# /socket.io through nginx so both share the same origin.
# Set to the public URL of your frontend in production.
CLIENT_ORIGIN=http://localhost:80


# --------------------------------------------------------------
# Frontend (React → nginx)
# --------------------------------------------------------------

# Host port that nginx binds to on the Docker host.
# Browse to http://localhost:<CLIENT_PORT> to open the app.
CLIENT_PORT=80

# React build-time env vars (baked into the static bundle).
# When nginx proxies /api and /socket.io to the backend,
# the browser uses the same origin for both — leave these
# as the defaults below for standard Docker Compose usage.
#
# Override only if your backend is on a separate domain/port.
REACT_APP_API_BASE=/api
REACT_APP_SOCKET_URL=


# --------------------------------------------------------------
# Docker Registry (used by Jenkinsfile push stages)
# --------------------------------------------------------------

# Docker Hub username or private registry hostname.
# Example Docker Hub:  myusername
# Example ECR:         123456789.dkr.ecr.us-east-1.amazonaws.com
DOCKER_REGISTRY=myusername

# Registry credential ID configured in Jenkins Credentials Store.
# Jenkins uses this ID to log in before pushing images.
DOCKER_CREDENTIALS_ID=docker-hub-credentials


# --------------------------------------------------------------
# Jenkins Pipeline
# --------------------------------------------------------------

# Git repository URL cloned by Jenkins.
GIT_REPO_URL=https://github.com/your-org/video-meet.git

# Branch Jenkins checks out and builds.
GIT_BRANCH=main
